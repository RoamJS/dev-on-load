{
  "name": "reload-developer-extensions",
  "version": "1.0.0",
  "description": "Reload developer extensions once after a configurable startup delay.",
  "main": "index.js",
  "scripts": {
    "start": "samepage dev",
    "build:roam": "samepage build --dry",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format:check": "prettier --check src tests e2e README.md CHANGELOG.md package.json .github/workflows"
  },
  "keywords": [
    "roam",
    "roam-research",
    "roamjs"
  ],
  "license": "MIT",
  "dependencies": {
    "roamjs-components": "^0.86.4"
  },
  "devDependencies": {
    "prettier": "^3.2.5",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "samepage": {
    "extends": "node_modules/roamjs-components/package.json"
  }
}
